# Get your API key at https://vybe.fyi/api-pricing
VYBE_DATA_API_KEY=your_api_key_here

# Optional: Vybe API base URL (default: https://api.vybenetwork.xyz)
# VYBE_DATA_API_BASE=https://api.vybenetwork.xyz

# Optional: Server port (default 3009)
PORT=3009

# Google Analytics 4 measurement ID (G- plus 10 letters or digits).
# The page includes the Google tag only when this is a complete ID.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
